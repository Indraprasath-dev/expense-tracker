# Environment / secrets
# Backups of .env hold real credentials — the plain `.env` rule does not cover a suffixed copy,
# and one of these was sitting untracked and committable.
.env
.env.bak*
.env.backup*
.env.local
.env.*.local
!.env.example

# Virtual environments
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases and logs
*.db
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store

# Misc
*.mp4
